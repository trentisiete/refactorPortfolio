---
import type { Lang } from '../i18n/utils';
import { getAboutPath, getProfilePath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import JoseLogo from './JoseLogo.astro';

interface Props {
  lang: Lang;
  availableLangs?: Lang[];
  view?: 'reading' | 'profile' | 'about';
}

const { lang, availableLangs, view = 'reading' } = Astro.props;
const basePath = `/${lang}`;
const pathsFor = (pathForLang: (language: Lang) => string) => ({
  es: pathForLang('es'),
  en: pathForLang('en'),
  de: pathForLang('de'),
});
const languagePaths = view === 'profile'
  ? pathsFor(getProfilePath)
  : view === 'about'
    ? pathsFor(getAboutPath)
    : undefined;
const navigationLabels: Record<Lang, string> = {
  es: 'Navegación principal',
  en: 'Main navigation',
  de: 'Hauptnavigation',
};
---

<header class="site-header">
  <div class="container site-header__container">
    <div class="site-header__inner">
      <a href={`${basePath}/`} class="site-header__brand" aria-label="José Arbelaez">
        <JoseLogo instance="header" class="site-header__logo" decorative />
        <span class="site-header__name">José Arbelaez</span>
      </a>

      <nav class="site-header__nav" aria-label={navigationLabels[lang]}>
        <a
          href={getProfilePath(lang)}
          class:list={["site-header__nav-link", { "site-header__nav-link--active": view === 'profile' }]}
          aria-current={view === 'profile' ? 'page' : undefined}
        >
          <span>Journey</span>
        </a>
        <a
          href={getAboutPath(lang)}
          class:list={["site-header__nav-link", { "site-header__nav-link--active": view === 'about' }]}
          aria-current={view === 'about' ? 'page' : undefined}
        >
          <span>About me</span>
        </a>
      </nav>

      <div class="site-header__controls">
        <LanguageSwitcher lang={lang} availableLangs={availableLangs} paths={languagePaths} />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
