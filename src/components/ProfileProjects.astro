---
import ProfileProjectCard from './ProfileProjectCard.astro';
import type { ProfileProject } from '../data/profile.es';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  projects: ProfileProject[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="profile-projects" id="projects" aria-labelledby="profile-projects-title">
  <h2 id="profile-projects-title">{t.profile.projects_title}</h2>

  <div class="profile-projects__grid">
    {projects.length > 0 ? (
      projects.map(project => <ProfileProjectCard project={project} lang={lang} />)
    ) : (
      <article class="profile-project-card profile-project-card--placeholder">
        <p>{t.profile.projects_empty}</p>
      </article>
    )}

    <a
      class="profile-more-projects"
      href="https://github.com/trentisiete"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.profile.more_projects_title}: ${t.profile.more_projects_cta}`}
    >
      <div class="profile-more-projects__intro">
        <span class="profile-more-projects__eyebrow">github.com/trentisiete</span>
        <h3>{t.profile.more_projects_title}</h3>
        <p>{t.profile.more_projects_intro}</p>

        <strong class="profile-more-projects__cta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>{t.profile.more_projects_cta}</span>
          <i aria-hidden="true">↗</i>
        </strong>
      </div>

      <ol class="profile-more-projects__list">
        {t.profile.more_projects_items.map((item, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h4>{item.title}</h4>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </a>
  </div>
</section>
