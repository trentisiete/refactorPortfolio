---
import ProfileProjectCard from './ProfileProjectCard.astro';
import type { ProfileProject } from '../data/profile.es';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { projects: ProfileProject[]; lang: Lang }
const { projects, lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="profile-projects" id="projects" aria-labelledby="profile-projects-title">
  <header class="section-heading"><h2 id="profile-projects-title">{t.profile.projects_title}</h2></header>
  <div class="profile-projects__grid">
    {projects.map(project => <ProfileProjectCard project={project} lang={lang} />)}
  </div>
  <section class="profile-more-projects" aria-labelledby="more-projects-title">
    <header>
      <h3 id="more-projects-title">{t.profile.more_projects_title}</h3>
      <p>{t.profile.more_projects_intro}</p>
      <a href="https://github.com/trentisiete" target="_blank" rel="noopener noreferrer">{t.profile.more_projects_cta} ↗</a>
    </header>
    <ol class="profile-more-projects__list">
      {t.profile.more_projects_items.map(item => <li><div><h4>{item.title}</h4><p>{item.description}</p></div></li>)}
    </ol>
  </section>
</section>
