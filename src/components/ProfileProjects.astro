---
import ProfileProjectCard from './ProfileProjectCard.astro';
import LabProjects from './LabProjects.astro';
import type { ProfileProject, LabProject } from '../data/profile.es';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { projects: ProfileProject[]; labProjects: LabProject[]; lang: Lang }
const { projects, labProjects, lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="profile-projects" id="projects" aria-labelledby="profile-projects-title">
  <header class="section-heading"><h2 id="profile-projects-title">{t.profile.projects_title}</h2></header>
  <div class="profile-projects__grid">
    {projects.map(project => <ProfileProjectCard project={project} lang={lang} />)}
  </div>
  <LabProjects projects={labProjects} lang={lang} />
</section>
