---
import { getCollection, render } from 'astro:content';

const thoughtEntries = (await getCollection('thoughts'))
  .filter(thought => thought.data.lang === 'en' && !thought.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const THOUGHT_CAPTION_MAX_LENGTH = 96;

const getCaptionPreview = (caption?: string) => {
  const normalizedCaption = caption?.trim() ?? '';

  if (normalizedCaption.length <= THOUGHT_CAPTION_MAX_LENGTH) {
    return normalizedCaption;
  }

  const clippedCaption = normalizedCaption
    .slice(0, THOUGHT_CAPTION_MAX_LENGTH - 1)
    .replace(/\s+\S*$/, '')
    .trimEnd();

  return `${clippedCaption || normalizedCaption.slice(0, THOUGHT_CAPTION_MAX_LENGTH - 1)}…`;
};

const thoughts = await Promise.all(
  thoughtEntries.map(async entry => {
    const { Content } = await render(entry);
    const dateLabel = new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'Europe/Madrid',
    }).format(entry.data.publishedAt);
    const timeLabel = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
      timeZone: 'Europe/Madrid',
    }).format(entry.data.publishedAt);

    return { entry, Content, dateLabel, timeLabel };
  })
);
---

<section class="about-world about-home section">

  <header class="about-hero">
    <div class="about-hero__copy">

      <h1>
        about me,
        <em>off the clock.</em>
      </h1>
      <p class="about-hero__interests">
        Lately, I’m growing strawberries with sensors, getting back into training,
        and listening to jazz on vinyl.
      </p>
    </div>

  </header>

  <div class="about-content-layout">
  <section class="thoughts-section" id="thoughts" aria-labelledby="thoughts-title">
    <div class="thoughts-section__heading">
      <div>

        <h2 id="thoughts-title">current thoughts</h2>
      </div>
      <p>{thoughts.length} entries</p>
    </div>

    <div class="thought-window">


      <div
        class="thought-window__feed"
        aria-label="Thoughts ordered from newest to oldest"
      >
        {thoughts.length > 0 ? (
          thoughts.map(({ entry, Content, dateLabel, timeLabel }) => (
            <article class:list={['thought-entry', { 'thought-entry--with-image': entry.data.image }]}>
              <header>
                <time datetime={entry.data.publishedAt.toISOString()}>
                  <span>{dateLabel}</span>
                  <b>{timeLabel}</b>
                </time>
              </header>
              <div class="thought-entry__content">
                <div class="thought-entry__body">
                  <Content />
                </div>
                {entry.data.image && (
                  <figure class="thought-entry__media">
                    <button
                      class="thought-entry__image-button"
                      type="button"
                      data-thought-image-trigger
                      data-src={entry.data.image.src}
                      data-alt={entry.data.image.alt}
                      data-caption={entry.data.image.caption}
                      aria-label={`Open image: ${entry.data.image.alt}`}
                    >
                      <img
                        src={entry.data.image.src}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                      <span aria-hidden="true">view full ↗</span>
                    </button>
                    {entry.data.image.caption && (
                      <figcaption
                        aria-label={entry.data.image.caption}
                        title={entry.data.image.caption}
                      >
                        {getCaptionPreview(entry.data.image.caption)}
                      </figcaption>
                    )}
                  </figure>
                )}
              </div>
            </article>
          ))
        ) : (
          <div class="thought-window__empty">
            <div aria-hidden="true">
              <span>DAY</span>
              <span>DATE</span>
              <span>TIME</span>
            </div>
            <p>
              Nothing here yet. The next thought will arrive with its day,
              date and time.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <dialog class="thought-lightbox" data-thought-lightbox aria-label="Expanded thought image">
    <div class="thought-lightbox__bar">
      <span>image attachment</span>
      <form method="dialog">
        <button type="submit" aria-label="Close expanded image">close ×</button>
      </form>
    </div>
    <div class="thought-lightbox__canvas">
      <img data-thought-lightbox-image alt="" />
    </div>
    <p class="thought-lightbox__caption" data-thought-lightbox-caption hidden></p>
  </dialog>

  <section class="about-gateways" aria-label="More personal pages">
    <a class="about-gateway about-gateway--writing" href="/en/about/writing/">
      <svg class="about-gateway__frame" viewBox="0 0 280 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M14 29 L42 30 L44 10 L79 12 L80 24 L108 23 L110 8 L143 11 L144 28 L176 27 L178 12 L211 14 L210 27 L251 26 L250 49 L268 52 L267 83 L255 84 L257 117 L269 116 L267 151 L254 153 L256 191 L234 188 L231 207 L197 208 L195 195 L162 197 L161 211 L130 209 L129 195 L99 196 L98 209 L64 207 L65 192 L27 194 L29 174 L11 176 L12 141 L25 139 L23 108 L10 108 L12 75 L26 73 L25 48 L13 47 Z" />
      </svg>
      <div>
        <h2>Writing</h2>
        <p>Essays, notes and ideas that were too large for the thought box.</p>
      </div>
    </a>

    <a class="about-gateway about-gateway--music" href="/en/about/music/">
      <svg class="about-gateway__frame" viewBox="0 0 280 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M26 13 L62 11 L63 25 L96 26 L98 10 L128 12 L128 26 L162 24 L164 9 L200 12 L199 28 L234 27 L233 42 L267 44 L268 78 L254 80 L253 111 L269 113 L267 146 L253 145 L255 177 L242 178 L241 208 L207 206 L205 192 L172 194 L173 210 L139 208 L139 194 L108 195 L107 210 L75 208 L76 193 L42 192 L41 205 L13 203 L15 169 L27 167 L25 136 L10 135 L12 102 L26 104 L27 72 L12 71 L14 40 L27 39 Z" />
      </svg>
      <div>
        <h2>Music</h2>
        <p>A small place for playlists and the music I like.</p>
      </div>
    </a>
  </section>
  </div>
</section>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-thought-lightbox]');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-thought-lightbox-image]');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('[data-thought-lightbox-caption]');

  document.querySelectorAll<HTMLButtonElement>('[data-thought-image-trigger]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      if (!lightbox || !lightboxImage || !lightboxCaption) return;

      lightboxImage.src = trigger.dataset.src ?? '';
      lightboxImage.alt = trigger.dataset.alt ?? '';

      const caption = trigger.dataset.caption ?? '';
      lightboxCaption.textContent = caption;
      lightboxCaption.hidden = caption.length === 0;
      lightbox.showModal();
    });
  });

  lightbox?.addEventListener('click', event => {
    if (event.target === lightbox) lightbox.close();
  });

  lightbox?.addEventListener('close', () => {
    if (lightboxImage) lightboxImage.removeAttribute('src');
  });
</script>
