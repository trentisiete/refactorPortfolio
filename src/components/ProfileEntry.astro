---
import type { ProfileEntry } from '../data/profile.es';
interface Props { entry: ProfileEntry }
const { entry } = Astro.props;
---
<article class="profile-entry">
  <div class="profile-entry__row">
    <span class="profile-entry__logo" aria-hidden="true">
      <span class="profile-entry__logo-face">
        {entry.logo.src
          ? <img src={entry.logo.src} alt="" loading="lazy" width="48" height="48" />
          : <span>{entry.logo.initials}</span>}
      </span>
    </span>
    <div class="profile-entry__heading">
      <h3 class="profile-entry__title">{entry.title}</h3>
      <p class="profile-entry__meta">
        <span class="profile-entry__organization">{entry.organization}</span>
        {entry.period && <span class="profile-entry__period">{entry.period}</span>}
      </p>
      {entry.location && <p class="profile-entry__location">{entry.location}</p>}
    </div>
  </div>
  {(entry.details?.length || entry.links?.length) && <div class="profile-entry__body">
    {entry.details?.length && <ul class="profile-entry__details">
      {entry.details.map(detail => <li>{detail}</li>)}
    </ul>}
    {entry.links?.length && <div class="profile-entry__links">
      {entry.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>)}
    </div>}
  </div>}
</article>
