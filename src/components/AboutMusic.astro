---
import { aboutPlaylists, type AboutPlaylist } from '../data/aboutPlaylists';

const platformDetails = {
  youtube: {
    label: 'YouTube',
    allow:
      'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
  },
  spotify: {
    label: 'Spotify',
    allow:
      'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture',
  },
} as const;

const embedUrlFor = (item: AboutPlaylist) =>
  item.platform === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/videoseries?list=${item.id}`
    : `https://open.spotify.com/embed/${item.kind}/${item.id}?utm_source=generator&theme=0`;

const externalUrlFor = (item: AboutPlaylist) =>
  item.platform === 'youtube'
    ? `https://youtube.com/playlist?list=${item.id}`
    : `https://open.spotify.com/${item.kind}/${item.id}`;

const seeded = (seed: number) => {
  let state = seed;
  return () => {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state / 2147483648;
  };
};

// The same cut-paper edge as the About gateways, but generated: the notches keep a
// constant size whatever the card's height, which one hand-drawn path stretched to
// fit could not do.
const cutFrame = (width: number, height: number, seed: number) => {
  const next = seeded(seed);
  const inset = 13;
  const points: string[] = [];
  const edge = (x0: number, y0: number, x1: number, y1: number, nx: number, ny: number) => {
    const length = Math.hypot(x1 - x0, y1 - y0);
    const steps = Math.max(4, Math.round(length / 46));
    for (let i = 0; i < steps; i += 1) {
      const t = i / steps;
      const jut = (i % 2 === 0 ? 1 : -1) * (5 + next() * 7.5);
      points.push(
        `${(x0 + (x1 - x0) * t + nx * jut).toFixed(1)} ${(y0 + (y1 - y0) * t + ny * jut).toFixed(1)}`
      );
    }
  };
  edge(inset, inset, width - inset, inset, 0, -1);
  edge(width - inset, inset, width - inset, height - inset, 1, 0);
  edge(width - inset, height - inset, inset, height - inset, 0, 1);
  edge(inset, height - inset, inset, inset, -1, 0);
  return `M ${points.join(' L ')} Z`;
};

// The player gets the same edge at a smaller scale. A clip can only take material
// away, so the rhythm comes from alternating a shallow bite with a deep one.
// Percentages let the one path fit whatever size the embed ends up being.
const deckleEdge = (width: number, height: number, depth: number, seed: number) => {
  const next = seeded(seed);
  const fx = depth / width;
  const fy = depth / height;
  const points: string[] = [];
  const edge = (x0: number, y0: number, x1: number, y1: number, nx: number, ny: number) => {
    const steps = Math.max(6, Math.round(Math.hypot((x1 - x0) * width, (y1 - y0) * height) / 34));
    for (let i = 0; i < steps; i += 1) {
      const t = i / steps;
      const bite = (i % 2 === 0 ? 0.15 : 1) * (0.6 + next() * 0.4);
      points.push(
        `${((x0 + (x1 - x0) * t + nx * fx * bite) * 100).toFixed(2)}% ${((y0 + (y1 - y0) * t + ny * fy * bite) * 100).toFixed(2)}%`
      );
    }
  };
  edge(0, 0, 1, 0, 0, 1);
  edge(1, 0, 1, 1, -1, 0);
  edge(1, 1, 0, 1, 0, -1);
  edge(0, 1, 0, 0, 1, 0);
  return `polygon(${points.join(', ')})`;
};

const cards = aboutPlaylists.map((item, index) => {
  const width = 640;
  const height = item.platform === 'youtube' ? 475 : 580;
  const embedWidth = 440;
  const embedHeight = item.platform === 'youtube' ? Math.round(embedWidth * 9 / 16) : 352;
  return {
    item,
    width,
    height,
    frame: cutFrame(width, height, index * 977 + 13),
    clip: deckleEdge(embedWidth, embedHeight, 7, index * 613 + 41),
    tint: ['apricot', 'lilac', 'moss', 'rose'][index % 4],
  };
});
---

<section class="about-world about-subpage about-music section">
  <a class="about-back-link" href="/en/about/">← back to about me</a>

  <header class="music-masthead">
    <div>
      <p class="about-kicker">things I want to hear again</p>
      <h1>Music</h1>
      <p>
        I will add music I like here: playlists, albums and whatever I want to keep close.
      </p>
    </div>
  </header>

  <section class="playlist-shelf" aria-label="Music shelf">
    <header>
      <span>music shelf</span>
    </header>

    <div class="playlist-grid">
      {cards.map(({ item, width, height, frame, clip, tint }) => {
        const platform = platformDetails[item.platform];
        const kindLabel = item.kind === 'album' ? 'album' : 'playlist';

        return (
          <article class:list={['playlist-card', `playlist-card--${tint}`, `playlist-card--${item.platform}`]}>
            <svg
              class="playlist-card__frame"
              viewBox={`0 0 ${width} ${height}`}
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <path d={frame} />
            </svg>

            <header class="playlist-card__heading">
              <strong>{platform.label} · {kindLabel}</strong>
            </header>

            <div class="playlist-card__copy">
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </div>

            <div
              class:list={['playlist-embed', `playlist-embed--${item.platform}`]}
              style={`clip-path: ${clip};`}
            >
              <iframe
                src={embedUrlFor(item)}
                title={`${item.title} — ${platform.label} ${kindLabel} selected by José Arbelaez`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow={platform.allow}
                allowfullscreen
              ></iframe>
            </div>

            <a
              class="playlist-card__link"
              href={externalUrlFor(item)}
              target="_blank"
              rel="noopener noreferrer"
            >
              open {kindLabel} on {platform.label}
            </a>
          </article>
        );
      })}
    </div>
  </section>
</section>
