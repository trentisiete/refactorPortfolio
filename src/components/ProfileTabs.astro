---
import ProfileEntry from './ProfileEntry.astro';
import type { ProfileSection } from '../data/profile.es';
interface Props { sections: ProfileSection[]; label: string }
const { sections, label } = Astro.props;
---
<div class="career-layout">
  <nav class="career-nav" aria-label={label}>
    {sections.map(section => <a href={`#${section.id}`}>{section.label}<span aria-hidden="true">↘</span></a>)}
    <a class="career-cv" href="/CV_jose.pdf" target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↗</span></a>
  </nav>
  <div class="career-sections">
    {sections.map(section => <section class="career-section" id={section.id} aria-labelledby={`career-${section.id}`}>
      <header class="section-heading"><h2 id={`career-${section.id}`}>{section.label}</h2><span>{String(section.entries.length).padStart(2, '0')}</span></header>
      {section.entries.map(entry => <ProfileEntry entry={entry} />)}
    </section>)}
  </div>
</div>
