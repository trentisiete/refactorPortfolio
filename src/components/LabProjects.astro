---
import ProjectCover from './ProjectCover.astro';
import type { LabProject } from '../data/profile.es';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props { projects: LabProject[]; lang: Lang }
const { projects, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="profile-lab" aria-labelledby="profile-lab-title">
  <header class="profile-lab__heading">
    <h3 id="profile-lab-title">{t.profile.lab_title}</h3>
    <p>{t.profile.lab_intro}</p>
  </header>

  <div class="lab-grid">
    {projects.map(project => (
      <article class:list={['lab-project', `lab-project--${project.accent}`]}>
        <ProjectCover kind={project.id} />
        <div class="lab-project__copy">
          <h4>{project.title}</h4>
          {project.period && <p class="lab-project__period">{project.period}</p>}
          <p class="lab-project__excerpt">{project.excerpt}</p>
          <div class="lab-project__links">
            {project.links.map(link => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {link.kind === 'code' && (
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  )}
                  {link.kind === 'site' && (
                    <Fragment>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18" />
                    </Fragment>
                  )}
                  {link.kind === 'demo' && (
                    <Fragment>
                      <rect x="3" y="4" width="18" height="14" rx="2" />
                      <path d="M8 21h8M12 18v3M10.5 8.5l4 2.5-4 2.5Z" />
                    </Fragment>
                  )}
                  {link.kind === 'package' && (
                    <Fragment>
                      <path d="M21 8.5v7a2 2 0 0 1-1 1.73l-7 4a2 2 0 0 1-2 0l-7-4A2 2 0 0 1 3 15.5v-7a2 2 0 0 1 1-1.73l7-4a2 2 0 0 1 2 0l7 4A2 2 0 0 1 21 8.5Z" />
                      <path d="m3.5 7.5 8.5 5 8.5-5M12 21v-8.5" />
                    </Fragment>
                  )}
                  {link.kind === 'video' && (
                    <Fragment>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M10 8.5l6 3.5-6 3.5Z" />
                    </Fragment>
                  )}
                </svg>
                <span>{link.label}</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
