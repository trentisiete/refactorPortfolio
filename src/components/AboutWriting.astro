---
import { getCollection } from 'astro:content';
import { estimateReadingTime } from '../utils/readingTime';

const posts = (await getCollection('articles'))
  .filter(
    post =>
      post.data.lang === 'en' &&
      post.data.kind === 'blog' &&
      !post.data.draft
  )
  .sort((a, b) => {
    const dateA = typeof a.data.date === 'string' ? new Date(a.data.date) : a.data.date;
    const dateB = typeof b.data.date === 'string' ? new Date(b.data.date) : b.data.date;
    return dateB.getTime() - dateA.getTime();
  });

const formatDate = (date: Date | string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(typeof date === 'string' ? new Date(date) : date);
---

<section class="about-world about-subpage about-writing section">
  <a class="about-back-link" href="/en/about/">← back to about me</a>

  <header class="writing-masthead">
    <h1>Writing</h1>
    <p>
      Longer notes, essays and whatever else survives the draft folder.
    </p>
  </header>

  <div class="writing-board">
    <div class="writing-list">
      {posts.length > 0 ? (
        posts.map(post => {
          const slug = post.slug.split('/').pop();
          const readingTime = estimateReadingTime(post.body, 'en');

          return (
            <a class="writing-row" href={`/en/articles/${slug}/`}>
              <div class="writing-row__copy">
                <h3>{post.data.title}</h3>
                {post.data.excerpt && <p>{post.data.excerpt}</p>}
              </div>
              <div class="writing-row__meta">
                <time>{formatDate(post.data.date)}</time>
                <span>{readingTime} min</span>
              </div>
            </a>
          );
        })
      ) : (
        <p class="writing-empty">The first text is still cooking.</p>
      )}
    </div>
  </div>
</section>
