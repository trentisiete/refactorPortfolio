const yearRow = (year: number) => years.indexOf(year) + 1;
const itemRow = (item: TimelineItem) => {
  if (item.throughCurrent) return `${yearRow(item.start)} / ${years.length + 1}`;
  return item.end ? `${yearRow(item.start)} / ${yearRow(item.end)}` : String(yearRow(item.start));
};
const itemEndYear = (item: TimelineItem) =>
  item.throughCurrent ? years[years.length - 1] + 1 : (item.end ?? item.start + 1);
const itemColumn = (item: TimelineItem) => {
  if (item.fullLane && item.lane === 'experience') return '2 / 4';
  if (item.fullLane && item.lane === 'education') return '4 / 6';
  if (item.lane === 'experience') return String(item.track + 1);
  if (item.lane === 'education') return String(item.track + 3);
  return '6';
};
const standaloneItems = items.filter(item => !item.awardStack);
const awardStackItems = items.filter(item => item.awardStack);
---

<div class="journey-timeline">
    <div
      class="journey-motion-demo fade-in fade-in-2"
      data-journey-reveal-root
      aria-label={journey.timelineLabel}
    >
      <div class="journey-motion-demo__track">
        <div class="journey-motion-demo__lanes" aria-label={journey.lanesLabel}>
          {journeyLanes.map(lane => (
            <span data-lane={lane.id} style={`grid-column: ${lane.columns}`}>
              {lane.label}
            </span>
          ))}
        </div>

        <div class="journey-motion-demo__canvas">
          {journeyYears.map((year, index) => (
            <div
              class="journey-motion-demo__year"
              style={`grid-row: ${index + 1}`}
              data-timeline-year={year}
              aria-label={`${journey.yearLabel} ${year}`}
            >
              <span>{year}</span>
              <i aria-hidden="true"></i>
            </div>
          ))}

          {journeyStandaloneItems.map(item => (
            <div
              class:list={[
                'journey-motion-demo__item',
                {
                  'journey-motion-demo__item--duration':
                    Boolean(item.end) || item.throughCurrent,
                },
              ]}
              style={`grid-row: ${journeyItemRow(item)}; grid-column: ${journeyItemColumn(item)}`}
              data-lane={item.lane}
              data-track={item.track}
              data-timeline-start={item.start}
              data-timeline-end={journeyItemEndYear(item)}
            >
              <JourneyRevealCard
                title={item.title}
                place={item.place}
                description={item.description}
                size={item.size}
                duration={Boolean(item.end) || item.throughCurrent}
                sticky={item.sticky}
                hidePlace={item.hidePlace}
                milestones={item.milestones}
              />
            </div>
          ))}

          {journeyStackGroups.map(group => (
            <div
              class="journey-motion-demo__stack"
              style={`grid-row: ${journeyYearRow(group.start)} / ${journeyYearRow(group.end)}; grid-column: ${journeyItemColumn(group)}`}
              data-lane={group.lane}
              data-track={group.track}
              data-timeline-start={group.start}
              data-timeline-end={group.end}
            >
              {group.items.map(item => (
                <JourneyRevealCard
                  title={item.title}
                  place={item.place}
                  description={item.description}
                  size={item.size}
                />
              ))}
            </div>
          ))}
        </div>

        <div class="journey-motion-demo__end" aria-hidden="true">
          <span>{journey.today}</span>
        </div>
      </div>
    </div>
</div>

<script>
  interface RevealState {
    element: HTMLElement;
    current: number;
    target: number;
    intensityCurrent: number;
    intensityTarget: number;
  }

  const clamp = (value: number) => Math.min(1, Math.max(0, value));

  const setupJourneyReveal = () => {
    document.querySelectorAll<HTMLElement>('[data-journey-reveal-root]').forEach(root => {
      if (root.dataset.journeyRevealReady === 'true') return;
      root.dataset.journeyRevealReady = 'true';

      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-journey-reveal-card]'));
      if (!cards.length) return;

      const yearMarkers = Array.from(
        root.querySelectorAll<HTMLElement>('[data-timeline-year]')
      );
      const timelineYears = yearMarkers
        .map(marker => Number(marker.dataset.timelineYear))
        .filter(Number.isFinite);
      const timelineItems = Array.from(
        root.querySelectorAll<HTMLElement>('[data-timeline-start][data-timeline-end]')
      );

      const syncYearHeights = () => {
        if (!timelineYears.length || !timelineItems.length) return;

        cards.forEach(card => {
          card.style.removeProperty('--journey-guided-height');
          delete card.dataset.heightGuided;
        });

        const minimumYearHeight = Math.min(
          320,
          Math.max(270, window.innerHeight * 0.34)
        );
        const yearHeights = timelineYears.map(() => minimumYearHeight);

        timelineYears.forEach(year => {
          root.style.setProperty(`--year-${year}-size`, `${minimumYearHeight}px`);
        });

        root.dataset.measuringYears = 'true';
        void root.offsetHeight;

        const heightCandidates = timelineItems.flatMap(element => {
          const itemCards = Array.from(
            element.querySelectorAll<HTMLElement>(':scope > [data-journey-reveal-card]')
          );
          const startYear = Number(element.dataset.timelineStart);
          const isStack = element.classList.contains('journey-motion-demo__stack');

          return itemCards.map((card, index) => ({
            card,
            startYear,
            naturalHeight: card.getBoundingClientRect().height,
            canReceiveGuide:
              !card.classList.contains('journey-reveal-card--duration') &&
              (!isStack || index === itemCards.length - 1),
          }));
        });

        timelineYears.forEach(year => {
          const candidates = heightCandidates.filter(candidate => candidate.startYear === year);
          const naturalHeights = [...new Set(
            candidates
              .map(candidate => Math.ceil(candidate.naturalHeight))
              .sort((a, b) => a - b)
          )];

          candidates.forEach(candidate => {
            if (!candidate.canReceiveGuide) return;

            const currentHeight = Math.ceil(candidate.naturalHeight);
            const nextHeight = naturalHeights.find(height => height > currentHeight + 1);
            if (!nextHeight) return;

            const gap = nextHeight - currentHeight;
            const allowedGap = Math.min(72, Math.max(36, currentHeight * 0.42));
            if (gap > allowedGap) return;

            candidate.card.style.setProperty(
              '--journey-guided-height',
              `${nextHeight}px`
            );
            candidate.card.dataset.heightGuided = 'true';
          });
        });

        void root.offsetHeight;

        const requirements = timelineItems
          .map(element => {
            const startYear = Number(element.dataset.timelineStart);
            const endYear = Number(element.dataset.timelineEnd);
            const startIndex = timelineYears.indexOf(startYear);
            const endIndexCandidate = timelineYears.findIndex(year => year >= endYear);
            const endIndex =
              endIndexCandidate === -1 ? timelineYears.length : endIndexCandidate;

            if (startIndex === -1 || endIndex <= startIndex) return null;

            const styles = window.getComputedStyle(element);
            const marginTop = Number.parseFloat(styles.marginTop) || 0;
            const marginBottom = Math.max(
              Number.parseFloat(styles.marginBottom) || 0,
              20
            );
            const naturalHeight = element.getBoundingClientRect().height;

            return {
              startIndex,
              endIndex,
              span: endIndex - startIndex,
              requiredHeight: Math.ceil(
                naturalHeight + marginTop + marginBottom + 12
              ),
            };
          })
          .filter(
            (
              requirement
            ): requirement is {
              startIndex: number;
              endIndex: number;
              span: number;
              requiredHeight: number;
            } => requirement !== null
          )
          .sort((a, b) => a.span - b.span);

        root.removeAttribute('data-measuring-years');

        requirements.forEach(requirement => {
          const availableHeight = yearHeights
            .slice(requirement.startIndex, requirement.endIndex)
            .reduce((total, height) => total + height, 0);
          const missingHeight = requirement.requiredHeight - availableHeight;

          if (missingHeight <= 0) return;

          const extraPerYear = missingHeight / requirement.span;
          for (
            let index = requirement.startIndex;
            index < requirement.endIndex;
            index += 1
          ) {
            yearHeights[index] += extraPerYear;
          }
        });

        timelineYears.forEach((year, index) => {
          root.style.setProperty(`--year-${year}-size`, `${Math.ceil(yearHeights[index])}px`);
        });
      };

      const stickyCards = cards.filter(card =>
        card.classList.contains('journey-reveal-card--sticky')
      );
      const syncStickyOffsets = () => {
        stickyCards.forEach(card => {
          const identity = card.querySelector<HTMLElement>('.journey-reveal-card__identity');
          if (!identity) return;

          card.style.setProperty('--journey-identity-height', `${identity.offsetHeight}px`);
        });
      };

      let refreshReveal: (() => void) | undefined;
      const refreshLayout = () => {
        syncYearHeights();
        syncStickyOffsets();
        refreshReveal?.();
      };

      refreshLayout();
      const stickyResizeObserver = new ResizeObserver(syncStickyOffsets);
      stickyCards.forEach(card => stickyResizeObserver.observe(card));

      window.addEventListener('resize', refreshLayout, { passive: true });
      document.fonts.ready.then(refreshLayout);

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      root.dataset.motionReady = 'true';

      const states: RevealState[] = cards.map(element => ({
        element,
        current: 1,
        target: 1,
        intensityCurrent: 1,
        intensityTarget: 1,
      }));

      let frame = 0;

      const measure = (immediate = false) => {
        const revealLine = window.innerHeight * 0.88;
        const minimumDistance = window.innerHeight * 0.46;

        states.forEach(state => {
          const cardRect = state.element.getBoundingClientRect();
          const revealDistance = Math.max(cardRect.height, minimumDistance);
          state.target = clamp((revealLine - cardRect.top) / revealDistance);
          const intensityDistance = state.element.classList.contains(
            'journey-reveal-card--duration'
          )
            ? Math.max(220, window.innerHeight * 0.42)
            : revealDistance;
          state.intensityTarget = clamp(
            (revealLine - cardRect.top) / intensityDistance
          );

          if (immediate) {
            state.current = state.target;
            state.intensityCurrent = state.intensityTarget;
            state.element.style.setProperty('--journey-reveal', state.current.toFixed(4));
            state.element.style.setProperty(
              '--journey-intensity',
              state.intensityCurrent.toFixed(4)
            );
          }
        });
      };

      const animate = () => {
        let moving = false;

        states.forEach(state => {
          const revealDistance = state.target - state.current;
          const intensityDistance = state.intensityTarget - state.intensityCurrent;

          if (Math.abs(revealDistance) > 0.001) {
            state.current += revealDistance * 0.16;
            moving = true;
          } else {
            state.current = state.target;
          }

          if (Math.abs(intensityDistance) > 0.001) {
            state.intensityCurrent += intensityDistance * 0.16;
            moving = true;
          } else {
            state.intensityCurrent = state.intensityTarget;
          }

          state.element.style.setProperty('--journey-reveal', state.current.toFixed(4));
          state.element.style.setProperty(
            '--journey-intensity',
            state.intensityCurrent.toFixed(4)
          );
        });

        frame = moving ? window.requestAnimationFrame(animate) : 0;
      };

      const update = () => {
        measure();
        if (!frame) frame = window.requestAnimationFrame(animate);
      };

      refreshReveal = update;
      measure(true);
      window.addEventListener('scroll', update, { passive: true });
    });
  };

  setupJourneyReveal();
  document.addEventListener('astro:page-load', setupJourneyReveal);
</script>
