---
import JourneyRevealCard from './JourneyRevealCard.astro';
import type { JourneyMilestone } from './JourneyRevealCard.astro';
import type { Lang } from '../i18n/utils';
import {
  getJourneyTimelineData,
  type JourneyLaneId,
  type JourneyTimelineItem,
  type JourneyTrack,
} from '../data/journey';

interface Props {
  lang: Lang;
}

interface JourneyStackGroup {
  id: string;
  lane: JourneyLaneId;
  track: JourneyTrack;
  start: number;
  end: number;
  items: JourneyTimelineItem[];
}

const { lang } = Astro.props;
const journey = getJourneyTimelineData(lang);
const journeyYears = journey.years;
const journeyLanes: { id: JourneyLaneId; label: string; columns: string }[] = [
  { id: 'experience', label: journey.lanes.experience, columns: '2 / 4' },
  { id: 'education', label: journey.lanes.education, columns: '4 / 7' },
  { id: 'awards', label: journey.lanes.awards, columns: '7' },
];

const journeyYearRow = (year: number) => journeyYears.indexOf(year) + 1;
const journeyItemEndYear = (item: JourneyTimelineItem) =>
  item.throughCurrent
    ? journeyYears[journeyYears.length - 1] + 1
    : (item.end ?? item.start + 1);
const journeyItemRow = (item: JourneyTimelineItem) => {
  if (item.throughCurrent) {
    return `${journeyYearRow(item.start)} / ${journeyYears.length + 1}`;
  }

  return item.end
    ? `${journeyYearRow(item.start)} / ${journeyYearRow(item.end)}`
    : String(journeyYearRow(item.start));
};
const journeyItemColumn = (item: Pick<JourneyTimelineItem, 'lane' | 'track'>) => {
  if (item.lane === 'experience') return String(item.track + 1);
  if (item.lane === 'education') return String(item.track + 3);
  return '7';
};
const journeyStandaloneItems = journey.items.filter(item => !item.stack);
const journeyStackGroups: JourneyStackGroup[] = Array.from(
  new Set(journey.items.flatMap(item => item.stack ? [item.stack] : []))
).map(id => {
  const items = journey.items.filter(item => item.stack === id);
  const firstItem = items[0];

  return {
    id,
    lane: firstItem.lane,
    track: firstItem.track,
    start: Math.min(...items.map(item => item.start)),
    end: Math.max(...items.map(journeyItemEndYear)),
    items,
  };
});

type LaneId = 'experience' | 'education' | 'awards';
type CardSize = 'compact' | 'medium' | 'tall';

interface TimelineItem {
  id: string;
  lane: LaneId;
  track: 1 | 2;
  start: number;
  end?: number;
  title: string;
  place: string;
  description: string;
  size: CardSize;
  sticky?: boolean;
  hidePlace?: boolean;
  fullLane?: boolean;
  throughCurrent?: boolean;
  awardStack?: 'top' | 'bottom';
  milestones?: JourneyMilestone[];
}

const years = [2021, 2022, 2023, 2024, 2025, 2026];

const lanes: { id: LaneId; label: string; columns: string }[] = [
