  },
  {
    id: 'naudit',
    lane: 'experience',
    track: 2,
    start: 2026,
    title: 'Data Scientist Intern',
    place: 'Naudit HPCN',
    description: 'La etapa más reciente cerrará por ahora la cronología con una reflexión breve.',
