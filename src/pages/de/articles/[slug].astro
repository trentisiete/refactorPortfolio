---
import ArticlePage from '../../../components/ArticlePage.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('articles')).filter(a => a.data.lang === 'de' && !a.data.draft).map(article => ({ params: { slug: article.slug.split('/').pop() }, props: { article } }));
}
const { article } = Astro.props;
---
<ArticlePage article={article} lang="de" />
